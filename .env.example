# Variables d'environnement de la fonction /api/devis.
# En production : Cloudflare Pages > projet > Settings > Variables and Secrets (type « Secret » pour la clé).
# En local : copier ce fichier en .dev.vars (ignoré par Git) pour `npx wrangler pages dev .`
# Ne jamais commiter de vraie valeur.

# Clé API Brevo (Brevo > SMTP & API > Clés API). OBLIGATOIRE.
BREVO_API_KEY=

# Adresse qui reçoit les demandes de devis (mail pro). OBLIGATOIRE.
CONTACT_TO_EMAIL=contact@crtvstudios.fr

# Copie(s) CACHÉE(S) de chaque demande, séparées par des virgules (ex. une boîte qui notifie bien sur téléphone). Facultatif.
NOTIFY_CC=

# Expéditeur des notifications : doit être un expéditeur validé dans Brevo (Expéditeurs, domaines et IP dédiées). OBLIGATOIRE.
SENDER_EMAIL=contact@crtvstudios.fr
SENDER_NAME=Site CRTV Studios

# Liste Brevo où ranger chaque demande (numéro visible dans Contacts > Listes). Facultatif.
BREVO_LIST_ID=
# Liste Brevo « Actualités », utilisée seulement si la personne a coché la case. Facultatif.
BREVO_NEWSLETTER_LIST_ID=
# Attribut Brevo qui reçoit le nom (ex. NOM sur un compte en français, LASTNAME en anglais). Facultatif.
BREVO_NAME_ATTRIBUTE=NOM

# Anti-robot Cloudflare Turnstile. Facultatif : à activer seulement si du spam passe.
# La clé de site (publique) se met dans index.html, attribut data-turnstile-sitekey du formulaire.
TURNSTILE_SECRET_KEY=

# Autres origines autorisées à appeler /api/devis, séparées par des virgules (ex. aperçu *.pages.dev). Facultatif.
ALLOWED_ORIGINS=
